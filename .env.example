# Copy to backend/.env and adjust. Never commit the real .env.
JARVIS_LOG_LEVEL=INFO
# IANA timezone name, e.g. America/New_York, Europe/London, Asia/Kolkata
JARVIS_DEFAULT_TIMEZONE=America/New_York
# metric or imperial
JARVIS_DEFAULT_UNITS=imperial
# Your city, used for "what's the weather?" with no place named (empty = ask)
JARVIS_DEFAULT_LOCATION=

# LLM — any OpenAI-compatible Chat Completions server.
# Local Ollama (default, free):
JARVIS_LLM_BASE_URL=http://localhost:11434/v1
JARVIS_LLM_MODEL=qwen3:8b
# Hosted providers need a key, e.g. Groq:
#   JARVIS_LLM_BASE_URL=https://api.groq.com/openai/v1
#   JARVIS_LLM_MODEL=<model name from the provider's docs>
#   JARVIS_LLM_API_KEY=...

# Voice (text-to-speech, local Kokoro). One voice or a blend, e.g.
#   JARVIS_TTS_VOICE=am_michael:60,bm_george:40
JARVIS_TTS_VOICE=af_heart
JARVIS_TTS_SPEED=1.0
